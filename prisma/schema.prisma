// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  totpEnabled     Boolean   @default(false)
  totpSecretEnc   String?   // AES-GCM encrypted TOTP secret
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  servers         Server[]
  taskLogs        TaskLog[]
  auditLogs       AuditLog[]
  trustedDevices  TrustedDevice[]
}

/** Dispositivos de confianza para saltar 2FA (cookie httpOnly, 30 días). */
model TrustedDevice {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  label     String?  // user-agent corto
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

model Server {
  id             String    @id @default(uuid())
  owner          User      @relation(fields: [userId], references: [id])
  userId         String
  name           String
  hostname       String
  ip             String
  os             String    // 'ubuntu', 'debian', 'almalinux', etc.
  connectionType String    @default("ssh")
  sshPort        Int       @default(22)
  sshUser        String    @default("root")
  authMethod     AuthMethod
  credential     String    // Encrypted password or SSH Private Key text
  /** SHA256 fingerprint of remote host key (ssh-keygen -lf style, base64) */
  sshHostFingerprint String?
  status         ServerStatus @default(ACTIVE)
  notes          String?
  tags           String?   // JSON stringified array
  alertsMutedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  taskLogs       TaskLog[]
  metricHistory  MetricHistory[]
  triggers       ServerTrigger[]
  novaAgent      NovaAgent?
}

model NovaAgent {
  id                 String            @id @default(uuid())
  server             Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId           String            @unique
  installStatus      NovaInstallStatus @default(UNKNOWN)
  installedVersion   String?
  installedSha256    String?
  lastCheckedAt      DateTime?
  lastRunAt          DateTime?
  monitoringStatus   String?           // ok | degraded | unknown | error
  activeAlerts       Int               @default(0)
  modules            String?           // JSON: { linux, docker, plesk, s3 }
  thresholds         String?           // JSON thresholds overlay
  capabilities       String?           // JSON detected features
  lastError          String?
  lastOperationId    String?
  operationLockUntil DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  operations         NovaOperation[]
}

model NovaOperation {
  id         String     @id @default(uuid())
  agent      NovaAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId    String
  type       String     // install | update | reinstall | diagnose | refresh | test_telegram | configure | migrate
  status     TaskStatus @default(RUNNING)
  progress   String?
  stdout     String?
  stderr     String?
  userId     String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  durationMs Int?
}

enum NovaInstallStatus {
  NOT_INSTALLED
  INSTALLED
  UPDATE_AVAILABLE
  INSTALLING
  UPDATING
  INSTALL_ERROR
  CONNECTION_ERROR
  UNKNOWN
}

model MetricHistory {
  id        String   @id @default(uuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  cpu       Float
  ram       Float
  disk      Float
  createdAt DateTime @default(now())
}

model ServerTrigger {
  id            String   @id @default(uuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  metric        String   // 'CPU', 'RAM', 'DISK'
  condition     String   // 'GT' (Greater Than), 'LT' (Less Than)
  threshold     Float
  durationMins  Int      @default(5)
  actionTaskName String   // Name of the task to execute (more flexible than ID)
  isEnabled     Boolean  @default(true)
  lastTriggered DateTime?
  createdAt     DateTime @default(now())
}

enum AuthMethod {
  PASSWORD
  KEY
}

enum ServerStatus {
  ACTIVE
  INACTIVE
}

model RemoteTask {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  commandTemplate String   // SSH bash command
  osTarget        String   // 'all', 'ubuntu', 'debian'
  /** Si true, notifica también cuando la tarea termina OK (por defecto solo errores). */
  notifyOnSuccess Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TaskLog {
  id          String   @id @default(uuid())
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId    String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  taskName    String
  status      TaskStatus @default(RUNNING)
  stdout      String?  
  stderr      String?  
  exitCode    Int?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  durationMs  Int?
}

enum TaskStatus {
  RUNNING
  SUCCESS
  ERROR
}

model AuditLog {
  id          String   @id @default(uuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  action      String   // e.g. "CREATE_USER"
  entity      String   // e.g. "User"
  entityId    String?
  details     String?  // JSON context
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model AppConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON payload
  updatedAt DateTime @updatedAt
}
