# Prisma / Postgres (solo red Docker interna; no publicar 5432)
POSTGRES_USER="obenus"
POSTGRES_PASSWORD="GENERAR_CONTRASEÑA_LARGA_ALEATORIA"
POSTGRES_DB="obenus_db"
DATABASE_URL="postgresql://obenus:GENERAR_CONTRASEÑA_LARGA_ALEATORIA@postgres:5432/obenus_db?schema=public"

# BullMQ Redis (requirepass obligatorio)
REDIS_PASSWORD="GENERAR_CONTRASEÑA_LARGA_ALEATORIA"
REDIS_URL="redis://:GENERAR_CONTRASEÑA_LARGA_ALEATORIA@redis:6379"

# NextAuth
NEXTAUTH_SECRET="GENERAR_SECRETO_LARGO_ALEATORIO"
NEXTAUTH_URL="https://tu-dominio.ejemplo"

# Admin inicial (obligatorio en producción; sin fallback débil)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@tu-dominio.ejemplo"
ADMIN_PASSWORD="GENERAR_CONTRASEÑA_FUERTE"

# Cifrado AES-256-GCM de credenciales SSH / secretos (mín. 32 caracteres aleatorios)
APP_SECRET_KEY="GENERAR_CLAVE_MINIMO_32_CHARS_ALEATORIOS"

# Backups Postgres (días de retención en ./backups)
BACKUP_RETENTION_DAYS="14"

# Opcional SMTP por env (preferible configurar en UI; pass se cifra en BD)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
